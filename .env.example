# =============================================================================
# NEON STORE — Environment Variables (Railway)
# =============================================================================

# --- Telegram ---
BOT_TOKEN=
ADMIN_PASSWORD=
ADMIN_ID=
SUPPORT_USERNAME=
WEBAPP_URL=

# --- Userbot (avto to'ldirish + gift yetkazish) ---
API_ID=
API_HASH=
SESSION_STRING=
# Avto to'ldirish manbasi (HUMO bank xabarlari)
TOPUP_SOURCE_CHAT=@humocardbot

# --- Balans to'ldirish (HUMO karta) ---
CARD_NUMBER=
CARD_HOLDER=

# =============================================================================
# TON / USDT (Fragment) — Stars FAQAT USDT (TON) orqali xarid qilinadi
# =============================================================================
# TON hamyon 24 ta so'z (WALLET_SEED) — Fragment to'lovlari shu hamyondan yuboriladi
WALLET_SEED=

# USDT jetton master (TON zanjiri). O'zgartirmaslikiz ham mumkin.
USDT_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

# TON lite-server ishonch darajasi:
#   2 (tavsiya) — bloklarni tekshiradi, "Liteserver crashed with 651" kamayadi
#   1 — tezroq, lekin shard out-of-sync bo'lsa xarid uzilishi mumkin
TON_TRUST_LEVEL=2

# 1 Stars uchin taxminiy USDT narxi (xabarlarda ko'rsatiladi)
# 50 Stars ≈ 0.75 USDT  ->  0.015 USDT/Stars
STAR_USDT_RATE=0.015

# 1 Stars uchun maksimal USDT (faqat Fragment javobini tekshirish uchun chegara)
USDT_MAX_PER_STAR=0.03

# USDT -> UZS kurs zaxirasi (live API ishlamasa shu ishlatiladi)
USDT_RATE_UZS=13000
# Kesh muddati (soniya)
USDT_RATE_TTL=300

# Fragment.com cookie'lari (brauzerdan ko'chiriladi, qo'shtirnoq bilan)
# Qayerdan olish: fragment.com/stars -> DevTools -> Network -> "api" so'rovi ->
#   Request Headers -> "Cookie: ..." qiymati to'liq nusxalanadi
# FRAGMENT_COOKIE_HEADER="stel_ssid=...; stel_dt=-300; stel_token=...; stel_ton_token=..."

# api_hash: fragment.com/stars sahifasidagi ?hash=... yoki data-api-hash="..."
# Ko'rsatmasdan bo'lsa, bot sahifani o'zi ochib avtomatik oladi.
FRAGMENT_API_HASH=
FRAGMENT_USER_AGENT=
# Fragment manzili (bo'lsa avtomatik aniqlanadi)
FRAGMENT_ADDRESS=
# Ixtiyoriy proxy: http://user:pass@ip:port
FRAGMENT_PROXY=

# Fragment ichki to'lov usuli kodi.
# KO'RSATILGAN nomni emas, ICHKI KODni yuborish kerak:
#   GRAM -> "ton" | USDT -> odatda "crypto" ("usdt" ishlashi mumkin emas)
# Bo'sh qoldirilsa, bot ["crypto", "usdt", "jetton"] ni ketma-ket sinab,
# qaysi biri ishlashini o'zi topadi (logda "Fragment to'lov usuli: X" yoziladi).
# Aniq kod: fragment.com/stars -> DevTools -> Network -> initBuyStarsRequest
#           -> Payload -> payment_method
FRAGMENT_PAYMENT_METHOD=
